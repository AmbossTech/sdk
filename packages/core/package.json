{
  "name": "@ambosstech/core",
  "version": "0.2.0",
  "description": "Shared client and HTTP/GraphQL transport for Amboss SDKs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmbossTech/sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/AmbossTech/sdk/tree/main/packages/core",
  "bugs": "https://github.com/AmbossTech/sdk/issues",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist-cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    },
    "./schema": "./schema/rails.graphql"
  },
  "files": [
    "dist",
    "dist-cjs",
    "src",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && cp dist-cjs.package.json dist-cjs/package.json",
    "clean": "rm -rf dist dist-cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "refresh-schema": "tsx scripts/refresh-schema.ts"
  },
  "dependencies": {
    "graphql": "^16.10.0",
    "graphql-request": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
