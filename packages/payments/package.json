{
  "name": "@ambosstech/payments",
  "version": "1.0.2",
  "description": "Amboss Payments SDK: webhook verification, environments, wallets, transactions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmbossTech/sdk.git",
    "directory": "packages/payments"
  },
  "homepage": "https://github.com/AmbossTech/sdk/tree/main/packages/payments",
  "bugs": "https://github.com/AmbossTech/sdk/issues",
  "keywords": [
    "amboss",
    "lightning",
    "bitcoin",
    "payments",
    "webhook",
    "sdk"
  ],
  "type": "module",
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist-cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && cp dist-cjs.package.json dist-cjs/package.json",
    "clean": "rm -rf dist dist-cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:examples": "node examples/verify-webhook.mjs && node examples/verify-webhook.cjs",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.cjs.json",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@ambosstech/core": "workspace:*",
    "@noble/hashes": "^1.7.1",
    "graphql": "^16.10.0",
    "graphql-request": "^7.4.0",
    "nostr-tools": "^2.11.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "^4.4.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
